model Debt {
  id          String   @id
  type        String   // "DETTE" or "CRÉANCE"
  debtNature  String   @default("DETTE_NORMALE") // "DETTE_NORMALE" (on doit payer) ou "TROP_PERCU" (on a reçu trop)
  amount      Float
  paidAmount  Float    @default(0) // Montant déjà remboursé via transactions liées
  description String
  debtorType  String   // "MEMBER", "ASSOCIATION", "OTHER"
  debtorName  String
  debtorId    String?  // Optional: reference to member if debtorType = MEMBER
  dueDate     DateTime?
  status      String   @default("EN_COURS") // EN_COURS, PAYÉE, ANNULÉE
  notes       String?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime

  @@index([type])
  @@index([status])
  @@index([dueDate])
}

