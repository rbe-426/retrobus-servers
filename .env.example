# Base de données SQLite
DATABASE_URL="file:./prisma/dev.db"

# Port du serveur (optionnel, par défaut 4000)
PORT=4000

# ============================================================
# 🚗 API D'IDENTIFICATION DE VÉHICULES
# ============================================================
# Provider actif : api_plaque (RECOMMANDÉ), api_auto, siv_auto, local, histovec, mock
# 
# PRODUCTION : Utilisez 'api_plaque' pour des données réelles du SIV
# DÉVELOPPEMENT : Utilisez 'mock' pour tester sans coûts
# 
# Voir CONFIGURATION_API_AUTO.md pour guide détaillé
VEHICLE_API_PROVIDER=mock

# ==================== ApiPlaqueImmatriculation (RECOMMANDÉ - DÉJÀ INSTALLÉ) ====================
# Package npm : apiplaqueimmatriculation (déjà installé via npm)
# Site web : https://apiplaqueimmatriculation.com
# Tarif : Variable selon abonnement
# Documentation : https://apiplaqueimmatriculation.com/documentation
#
# Pour activer :
# 1. Créez un compte sur apiplaqueimmatriculation.com
# 2. Obtenez votre token API
# 3. Décommentez et renseignez ci-dessous
# 4. Changez VEHICLE_API_PROVIDER=api_plaque
#
# API_PLAQUE_TOKEN=votre_token_ici

# ==================== API-AUTO.com (ALTERNATIF) ====================
# Inscription : https://www.api-auto.com/inscription
# Tarif : ~0.50€ par requête, essai gratuit disponible
# Documentation : https://www.api-auto.com/documentation
#
# API_AUTO_KEY=votre_cle_api_ici

# ==================== SIV-AUTO.fr (ALTERNATIF) ====================
# Alternative commerciale
# Tarif : ~100-200€/mois forfait
# SIV_AUTO_API_KEY=votre_cle_api_ici

# ==================== HistoVec (GOUVERNEMENTAL) ====================
# Service gratuit mais nécessite consentement propriétaire
# HISTOVEC_API_KEY=votre_cle_api_ici