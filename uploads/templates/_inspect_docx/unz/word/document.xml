rons sincèrement que cette expérience sera l’une des plus instructives et constructives,</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="NimbusSanL" w:hAnsi="NimbusSanL"/><w:b/><w:bCs/><w:sz w:val="32"/><w:szCs w:val="32"/></w:rPr><w:br/></w:r><w:r><w:rPr><w:rFonts w:ascii="NimbusSanL" w:hAnsi="NimbusSanL"/><w:b/><w:bCs/><w:sz w:val="32"/><w:szCs w:val="32"/></w:rPr><w:br/><w:t>Bien à vous,</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="NimbusSanL" w:hAnsi="NimbusSanL"/><w:b/><w:bCs/><w:sz w:val="32"/><w:szCs w:val="32"/></w:rPr><w:br/></w:r><w:r><w:rPr><w:rFonts w:ascii="NimbusSanL" w:hAnsi="NimbusSanL"/><w:b/><w:bCs/><w:sz w:val="32"/><w:szCs w:val="32"/></w:rPr><w:br/><w:t>Le Président.</w:t></w:r></w:p><w:p w14:paraId="190743D4" w14:textId="77777777" w:rsidR="002D14D8" w:rsidRDefault="002D14D8" w:rsidP="002D14D8"><w:pPr><w:rPr><w:rFonts w:ascii="NimbusSanL" w:hAnsi="NimbusSanL"/><w:b/><w:bCs/><w:sz w:val="32"/><w:szCs w:val="32"/></w:rPr></w:pPr></w:p><w:p w14:paraId="46C1DACE" w14:textId="77777777" w:rsidR="002D14D8" w:rsidRDefault="002D14D8" w:rsidP="002D14D8"><w:pPr><w:rPr><w:rFonts w:ascii="NimbusSanL" w:hAnsi="NimbusSanL"/><w:b/><w:bCs/><w:sz w:val="32"/><w:szCs w:val="32"/></w:rPr></w:pPr></w:p><w:p w14:paraId="15F3F2EC" w14:textId="77777777" w:rsidR="002D14D8" w:rsidRDefault="002D14D8" w:rsidP="002D14D8"><w:pPr><w:rPr><w:rFonts w:ascii="NimbusSanL" w:hAnsi="NimbusSanL"/><w:b/><w:bCs/><w:sz w:val="32"/><w:szCs w:val="32"/></w:rPr></w:pPr></w:p><w:p w14:paraId="4ABAF24B" w14:textId="77777777" w:rsidR="002D14D8" w:rsidRDefault="002D14D8" w:rsidP="002D14D8"><w:pPr><w:rPr><w:rFonts w:ascii="NimbusSanL" w:hAnsi="NimbusSanL"/><w:b/><w:bCs/><w:sz w:val="32"/><w:szCs w:val="32"/></w:rPr></w:pPr></w:p><w:p w14:paraId="00EE07AF" w14:textId="77777777" w:rsidR="002D14D8" w:rsidRDefault="002D14D8" w:rsidP="002D14D8"><w:pPr><w:rPr><w:rFonts w:ascii="NimbusSanL" w:hAnsi="NimbusSanL"/><w:noProof/></w:rPr></w:pPr></w:p><w:p w14:paraId="3B491E05" w14:textId="4212D699" w:rsidR="002D14D